{
  "expo": {
    "name": "weather-app",
    "slug": "weather-app",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/raindji.png",
    "scheme": "weatherapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./photo/2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.weatherapp"
    },
    "web": {
      "output": "static",
      "favicon": "./photo/3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/raindji.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f072a343-9a8a-41f7-a610-b78a377a36d1"
      }
    },
    "owner": "vladvaschenko",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f072a343-9a8a-41f7-a610-b78a377a36d1"
    }
  }
}
